{
  "name": "stepshelf",
  "version": "1.0.0",
  "private": true,
  "description": "Discord guides with private step-by-step reading",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "license": "MIT",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/test/*.test.js",
    "lint": "biome check .",
    "format": "biome check --write .",
    "supply": "node scripts/check-supply.mjs",
    "check": "npm run lint && npm test && npm run supply",
    "setup": "node scripts/setup.mjs",
    "register": "node --env-file-if-exists=.env dist/src/register.js",
    "start": "node --env-file-if-exists=.env dist/src/main.js"
  },
  "dependencies": {
    "discord.js": "14.27.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "24.19.2",
    "typescript": "5.9.3"
  }
}
